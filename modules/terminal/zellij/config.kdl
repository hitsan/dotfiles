// Only the differences from zellij's built-in defaults (`zellij setup --dump-config`).
keybinds {
    normal {
        bind "Ctrl a" { ToggleFocusFullscreen; }
        bind "Ctrl y" { GoToNextTab; }
    }
    shared_except "locked" {
        bind "Alt s" { NewPane "stacked"; SwitchToMode "normal"; }
    }
    // scroll and search keep Ctrl f as PageScrollDown.
    shared_except "locked" "scroll" "search" {
        bind "Ctrl f" {
            LaunchPlugin "filepicker" {
                close_on_selection true;
            };
        }
    }
    // Drop tmux mode; scroll and search keep Ctrl b as PageScrollUp.
    shared_except "locked" "scroll" "search" "tmux" {
        unbind "Ctrl b"
    }
}

plugins {
    compact-bar location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm"
    zjstatus-hints location="https://github.com/b0o/zjstatus-hints/releases/latest/download/zjstatus-hints.wasm" {
        max_length 0
        overflow_str "..."
        pipe_name "zjstatus_hints"
        hide_in_base_mode true
    }
}

// load_plugins replaces the default list instead of merging, so zellij:link is repeated here.
load_plugins {
    "zellij:link"
    zjstatus-hints
}

theme "nord"
default_layout "compact"
show_startup_tips false
