{
  "permissions": {
    "allow": [
      "Read",
      "WebFetch",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(which:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(sudo:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/modules/terminal/zellij/claude-mod"
  },
  "statusLine": {
    "type": "command",
    "command": "sh /home/hitsan/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "ppt-creator@daymade-skills": true,
    "typescript-lsp@claude-plugins-official": true,
    "draw-io@claude-drawio-skill": true,
    "ponytail@ponytail": true,
    "typesafe@typesafe-ai": true,
    "natural-japanese@natural-japanese": true
  },
  "extraKnownMarketplaces": {
    "claude-drawio-skill": {
      "source": {
        "source": "github",
        "repo": "little-hands/claude-drawio-skill"
      }
    },
    "claude-code-zellij-status": {
      "source": {
        "source": "git",
        "url": "https://github.com/thoo/claude-code-zellij-status.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "natural-japanese": {
      "source": {
        "source": "github",
        "repo": "coji/natural-japanese"
      }
    }
  },
  "language": "日本語",
  "effortLevel": "high",
  "tui": "fullscreen"
}
